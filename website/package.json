    "build": "python3 scripts/build-pages.py && python3 scripts/build-security.py",
    "test:security": "node tests/security-seo.cjs",
    "test:a11y": "node tests/accessibility.cjs"
  },
  "devDependencies": {
    "playwright": "1.48.2",
    "axe-core": "4.13.0"
  }
}
